{
  "name": "dave-services-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:electrical & npm run dev:cleaning & wait",
    "dev:electrical": "npm --workspace apps/electrical run dev",
    "dev:cleaning": "npm --workspace apps/cleaning run dev",
    "build:electrical": "npm --workspace apps/electrical run build",
    "build:cleaning": "npm --workspace apps/cleaning run build"
  }
}
